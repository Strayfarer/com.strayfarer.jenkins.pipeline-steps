#!/bin/sh

log=$FAKE_DOCKER_LOG
if [ -z "$log" ]; then
    log=$(dirname "$0")/../docker.log
fi
printf 'ARGS' >> "$log"
for argument in "$@"; do
    printf '|%s' "$argument" >> "$log"
done
printf '\n' >> "$log"

case "$1" in
    ps)
        for filter do :; done
        case "$filter" in
            'label=net.slothsoft.role=missing') ;;
            'label=net.slothsoft.role=multiple') printf 'label-first\nlabel-second\n' ;;
            'label=net.slothsoft.role=replacement')
                count=$(grep -c 'label=net.slothsoft.role=replacement' "$log")
                if [ "$count" -eq 1 ]; then printf 'label-first\n'; else printf 'label-second\n'; fi
                ;;
            'label=net.slothsoft.role=unity-sidecar') printf 'label-first\n' ;;
            *) exit 1 ;;
        esac
        ;;
    inspect)
        for container do :; done
        case "$container" in
            missing) exit 1 ;;
            stopped) printf 'false linux\n' ;;
            unsupported) printf 'true plan9\n' ;;
            *) printf 'true linux\n' ;;
        esac
        ;;
    exec)
        shift
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --workdir)
                    shift 2
                    ;;
                --env)
                    name=$2
                    value=$(printenv "$name")
                    printf 'ENV|%s|%s\n' "$name" "$value" >> "$log"
                    shift 2
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        container=$1
        shift
        printf 'EXEC|%s\n' "$container" >> "$log"
        case "$*" in
            *pkill*)
                printf 'KILL|%s\n' "$container" >> "$log"
                exit 0
                ;;
        esac
        exec "$@"
        ;;
    *)
        exit 2
        ;;
esac
